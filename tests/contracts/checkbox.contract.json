{
  "meta": {
    "id": "docs.custom.contract.checkbox",
    "version": "1.0.0",
    "created": "11-02-2026",
    "lastUpdated": "19-03-2026",
    "description": "Simple fluent DSL example for checkbox custom policy",
    "source": {
      "apg": "https://www.w3.org/WAI/ARIA/apg/patterns/checkbox/",
      "wcag": [
        "2.2 AA"
      ]
    },
    "W3CName": "Checkbox"
  },
  "selectors": {
    "main": "[role=group]",
    "checkbox": "[role=checkbox]",
    "relative": "[role=checkbox]"
  },
  "static": [
    {
      "target": "checkbox",
      "assertion": "toHaveAttribute",
      "attribute": "aria-checked",
      "expectedValue": "false",
      "failureMessage": "",
      "level": "required"
    }
  ],
  "dynamic": [
    {
      "description": "Space checks an unchecked checkbox.",
      "level": "required",
      "orientation": "horizontal",
      "action": [
        {
          "type": "keypress",
          "target": "relative",
          "key": "Space",
          "relativeTarget": 1
        }
      ],
      "assertions": [
        {
          "target": "relative",
          "relativeTarget": 1,
          "assertion": "toHaveAttribute",
          "attribute": "aria-checked",
          "expectedValue": "true",
          "failureMessage": "Expected checkbox to have aria-checked='true' when checked."
        }
      ]
    },
    {
      "description": "Space unchecks a checked checkbox.",
      "level": "required",
      "orientation": "horizontal",
      "action": [
        {
          "type": "keypress",
          "target": "relative",
          "key": "Space",
          "relativeTarget": 1
        }
      ],
      "assertions": [
        {
          "target": "relative",
          "relativeTarget": 1,
          "assertion": "toHaveAttribute",
          "attribute": "aria-checked",
          "expectedValue": "false",
          "failureMessage": "Expected checkbox to have aria-checked='false' when unchecked."
        }
      ],
      "setup": [
        {
          "type": "keypress",
          "target": "relative",
          "relativeTarget": 1,
          "key": "Space"
        }
      ]
    },
    {
      "description": "Click checks an unchecked checkbox.",
      "level": "required",
      "orientation": "horizontal",
      "action": [
        {
          "type": "click",
          "target": "relative",
          "relativeTarget": 1
        }
      ],
      "assertions": [
        {
          "target": "relative",
          "relativeTarget": 1,
          "assertion": "toHaveAttribute",
          "attribute": "aria-checked",
          "expectedValue": "true",
          "failureMessage": "Expected checkbox to have aria-checked='true' when checked."
        }
      ]
    },
    {
      "description": "Click unchecks a checked checkbox.",
      "level": "required",
      "orientation": "horizontal",
      "action": [
        {
          "type": "click",
          "target": "relative",
          "relativeTarget": 1
        }
      ],
      "assertions": [
        {
          "target": "relative",
          "relativeTarget": 1,
          "assertion": "toHaveAttribute",
          "attribute": "aria-checked",
          "expectedValue": "false",
          "failureMessage": "Expected checkbox to have aria-checked='false' when unchecked."
        }
      ],
      "setup": [
        {
          "type": "click",
          "target": "relative",
          "relativeTarget": 1
        }
      ]
    }
  ]
}
